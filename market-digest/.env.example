# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=digest
POSTGRES_PASSWORD=change_me

# Generate once and keep it. Losing it makes saved n8n credentials (Telegram token) unreadable.
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me

# Host port for the n8n UI. 5679 so it does not clash with an existing n8n on 5678.
N8N_PORT=5679
